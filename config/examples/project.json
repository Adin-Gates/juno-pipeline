{
    "$schema": "../schema/project.schema.json",
    "schema_version": 1,
    "pipeline_version": "0.1.0",
    "show": {
        "code": "DEMO",
        "title": "Demo Show",
        "status": "active"
    },
    "format": {
        "fps": 24,
        "resolution": [
            1920,
            1080
        ],
        "pixel_aspect": 1.0,
        "proxy_scales": [
            0.5,
            0.25
        ]
    },
    "frames": {
        "start": 1001,
        "padding": 4,
        "handles": {
            "head": 8,
            "tail": 8
        }
    },
    "color": {
        "ocio_config": "{show_root}/_pipeline/config/ocio/config.ocio",
        "working_space": "ACEScg",
        "display": "sRGB - Display",
        "view": "ACES 2.0 - SDR Video"
    },
    "departments": {
        "asset": {
            "character": ["mod","rig","tex"],
            "prop": ["mod","rig","tex"],
            "environment": ["mod","tex"],
            "vehicle": ["mod","rig","tex"]
        },
        "shot": [
            "prv",
            "lay",
            "anm",
            "cfx",
            "fx",
            "lgt",
            "cmp"
        ]
    },
    "fx": {
        "geo_format": "bgeo.sc",
        "volume_format": "vdb",
        "retention_days": 30,
        "sim_substeps_default": 1
    },
    "dcc": {
        "houdini": "22.0",
        "maya": "2026"
    }
}