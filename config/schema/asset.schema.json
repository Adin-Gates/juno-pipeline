{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Juno Asset Override",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "$schema": {
            "type": "string"
        },
        "name": {
            "type": "string",
            "description": "Asset name."
        },
        "type": {
            "type": "string",
            "description": "Asset type. Can be 'character','prop','environment', or 'vehicle'.",
            "enum": [
                "character",
                "prop",
                "environment",
                "vehicle"
            ]
        },
        "departments": {
            "type": "array",
            "description": "Departments utilized in creating this asset.",
            "items": {
                "$ref": "common.schema.json#/$defs/asset_department"
            },
            "default": [
                "mod",
                "tex"
            ]
        }
    },
    "required": [
        "name",
        "type"
    ]
}