{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Juno Project Config",
    "type": "object",
    "properties": {
        "show": {
            "type": "object",
            "description": "Identity of the show this config belongs to.",
            "properties": {
                "code": {
                    "type": "string",
                    "description": "Short uppercase show code, e.g. 'DEMO'. Used in paths and filenames. Letters and digits only, starts with a letter.",
                    "pattern": "^[A-Z][A-Z0-9]{1,9}$"
                },
                "title": {
                    "type": "string",
                    "description": "Long form show name, e.g. 'Demo Show'."
                },
                "status": {
                    "type": "string",
                    "enum": [
                        "active",
                        "archived"
                    ],
                    "description": "Production status of the show.",
                    "default": "active"
                }
            },
            "required": [
                "code",
                "title"
            ]
        },
        "format": {
            "$ref": "common.schema.json#/$defs/format"
        },
        "frames": {
            "$ref": "common.schema.json#/$defs/frames"
        },
        "color": {
            "$ref": "common.schema.json#/$defs/color"
        },
        "departments": {
            "type": "object",
            "description": "Which asset and shot departments will be included in this show's pipeline.",
            "properties": {
                "asset": {
                    "type": "array",
                    "description": "Short codes for which asset departments to include in this show's pipeline.",
                    "items": {
                        "type": "string",
                        "enum": [
                            "mod",
                            "rig",
                            "shd"
                        ]
                    },
                    "default": [
                        "mod",
                        "rig",
                        "shd"
                    ]
                },
                "shot": {
                    "type": "array",
                    "description": "Short code for which shot departments to include in this show's pipeline.",
                    "items": {
                        "type": "string",
                        "enum": [
                            "prv",
                            "lay",
                            "anm",
                            "cfx",
                            "fx",
                            "lgt",
                            "cmp"
                        ]
                    },
                    "default": [
                        "prv",
                        "lay",
                        "anm",
                        "cfx",
                        "fx",
                        "lgt",
                        "cmp"
                    ]
                }
            }
        },
        "fx": {
            "$ref": "common.schema.json#/$defs/fx"
        },
        "dcc": {
            "type": "object",
            "description": "Required production software versions.",
            "properties": {
                "houdini": {
                    "type": "string",
                    "description": "Required Houdini version for this show.",
                    "default": "22.0"
                },
                "maya": {
                    "type": "string",
                    "description": "Required Maya version for this show.",
                    "default": "2026"
                }
            }
        }
    },
    "required": [
        "show"
    ]
}