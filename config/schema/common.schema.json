{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$defs": {
        "format": {
            "type": "object",
            "description": "Show formatting.",
            "properties": {
                "fps": {
                    "type": "integer",
                    "description": "Show's default frames per second.",
                    "exclusiveMinimum": 0,
                    "default": 24
                },
                "resolution": {
                    "type": "array",
                    "description": "Show's default resolution.",
                    "items": {
                        "type": "integer",
                        "exclusiveMinimum": 0
                    },
                    "minItems": 2,
                    "maxItems": 2,
                    "default": [
                        1920,
                        1080
                    ]
                },
                "pixel_aspect": {
                    "type": "number",
                    "description": "Show's default pixel aspect ratio. 1.0 for square pixels.",
                    "default": 1.0
                },
                "proxy_scales": {
                    "type": "array",
                    "description": "Reduced resolution image versions to speed up non-final reviews. Is a fraction of the default resolution.",
                    "items": {
                        "type": "number",
                        "exclusiveMinimum": 0,
                        "maximum": 1
                    },
                    "default": [
                        0.5,
                        0.25
                    ]
                }
            }
        },
        "frames": {
            "type": "object",
            "description": "Default timeline settings.",
            "properties": {
                "start": {
                    "type": "integer",
                    "description": "Default starting frame for all shots.",
                    "exclusiveMinimum": 0,
                    "default": 1001
                },
                "padding": {
                    "type": "integer",
                    "description": "Number of digits forced in frame number, e.g '1' with a padding of 4 will display as '0001'.",
                    "exclusiveMinimum": 0,
                    "default": 4
                },
                "handles": {
                    "type": "object",
                    "description": "Number of frames to add to the start and end of each shot.",
                    "properties": {
                        "head": {
                            "type": "integer",
                            "description": "Number of frames to add before a given shot.",
                            "minimum": 0,
                            "default": 8
                        },
                        "tail": {
                            "type": "integer",
                            "description": "Number of frames to add after a given shot.",
                            "minimum": 0,
                            "default": 8
                        }
                    }
                }
            }
        },
        "color": {
            "type": "object",
            "description": "Show's default color space settings.",
            "properties": {
                "ocio_config": {
                    "type": "string",
                    "description": "File path to the ocio_config.",
                    "default": "{show_root}/_pipeline/config/ocio/config.ocio"
                },
                "working_space": {
                    "type": "string",
                    "description": "Working color space.",
                    "default": "ACEScg"
                },
                "display": {
                    "type": "string",
                    "description": "Display color space.",
                    "default": "sRGB - Display"
                },
                "view": {
                    "type": "string",
                    "description": "Viewing color space.",
                    "default": "ACES 2.0 - SDR Video"
                }
            }
        },
        "fx": {
            "type": "object",
            "description": "Show default FX caching settings.",
            "properties": {
                "geo_format": {
                    "type": "string",
                    "description": "Houdini default geo format. Normally 'bgeo.sc'.",
                    "default": "bgeo.sc"
                },
                "volume_format": {
                    "type": "string",
                    "description": "Houdini default volume format. Normally 'vdb'.",
                    "default": "vdb"
                },
                "retention_days": {
                    "type": "integer",
                    "description": "Number of days before low tier caches are eligible for deletion.",
                    "exclusiveMinimum": 0,
                    "default": 30
                },
                "sim_substeps_default": {
                    "type": "integer",
                    "description": "Houdini default sim substep count.",
                    "exclusiveMinimum": 0,
                    "default": 1
                }
            }
        },
        "asset_department": {
            "type": "string",
            "enum": ["mod","rig","tex"]
        }
    }
}